# Mars Bot config. Copy to `.env` and fill in. NEVER commit your real .env.
# Load it with:  set -a && source .env && set +a && node mars-bot.mjs
# (or use `node --env-file=.env mars-bot.mjs` on Node >= 20)

# ---- required ----
MARS_PK=0xYOUR_WALLET_PRIVATE_KEY          # the key that owns your plots/rigs/stones

# ---- network / API (defaults are correct for mainnet) ----
MARS_RPC=https://rpc.mainnet.chain.robinhood.com
# Use your private QuickNode RPC for lower latency / higher limits if you have one:
# MARS_RPC=https://your-endpoint.quiknode.pro/xxxxxxxx
MARS_API=https://project-mars.app

# ---- safety ----
MARS_DRY=1              # 1 = simulate only (default). Set 0 to actually send txs.

# ---- engine toggles ----
MARS_FARM=1            # 1 = auto plant + auto collect haulers
MARS_MARKET=1          # 1 = keep stones listed 1 tick under best ask

# ---- farm (engine 1) ----
MARS_TARGET_RIGS=100   # keep this many rigs planted (cap is 100/wallet)
# By default the farm plants haulers using the DRILL in your wallet, up to the
# 100-rig cap (it's bounded: each collect returns ~96% of cost + ore).
MARS_MAX_SPEND=0       # optional cap on PAID DRILL per cycle. 0 = no cap (spend all available).
MARS_DRILL_RESERVE=0   # keep this much DRILL unspent (safety buffer)
MARS_EXTERNAL=0        # 1 = also plant on other players' open, empty plots when yours run out
MARS_FARM_MS=30000     # farm loop cadence (ms)
MARS_COLLECT_CHUNK=20  # trays collected per tx

# ---- market (engine 2) ----
MARS_MARKET_MS=60000   # minimum ms between rebalances (floored at 60000 = 1/min)
MARS_MIN_LOT=2         # ignore ask lots smaller than this (2 = skip qty-1 dust). 1 disables.
MARS_DEPTH=10          # of the remaining asks, take price only once cumulative depth reaches this many units
MARS_MAX_LOTS=3        # sell-side depth to keep per stone, in lots of 99 (3 = up to 297 units). Contract caps a lot at 99.
MARS_RELIST_PCT=0.10   # relist to absorb newly-collected ore once wallet qty grows >= this fraction
MARS_FLOOR_DRILL=0     # extra absolute price floor per stone (DRILL). Best bid is always a floor too.
